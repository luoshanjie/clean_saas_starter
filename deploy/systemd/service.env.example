APP_CONFIG_FILE=/etc/service/app.yaml
APP_ENV=prod
ADDR=:9527
DB_DRIVER=postgres
DB_DSN=postgres://user:password@127.0.0.1:5432/service?sslmode=disable
SKIP_DB=0
JWT_SECRET=change-me
AUTH_LOGIN_SECOND_FACTOR_ENABLED=false
LOG_DIR=/var/log/service
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CONSOLE_FORMAT=json
LOG_CONSOLE=1
